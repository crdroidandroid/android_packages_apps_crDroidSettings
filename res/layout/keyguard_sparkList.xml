<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clock_frame"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal|top"
    android:gravity="center_horizontal|top"
    android:orientation="vertical">

    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <TextClock
            android:textSize="60sp"
            android:textStyle="normal"
            android:textColor="#d9ffffff"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/timeclock1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="-8dp"
            android:fontFamily="@*android:string/config_clockFontFamily"
            android:singleLine="true"
            android:textAllCaps="true"
            android:format12Hour="hh"
            android:format24Hour="kk"
            android:letterSpacing="0.05" />

        <ImageView
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="24dip"
            android:layout_height="8dip"
            android:src="@drawable/sparkls1_bg1"
            android:alpha="0.5" />

        <TextClock
            android:textSize="60sp"
            android:textStyle="normal"
            android:textColor="#d9ffffff"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/timeclock2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-8dp"
            android:fontFamily="@*android:string/config_clockFontFamily"
            android:singleLine="true"
            android:textAllCaps="true"
            android:format12Hour="mm"
            android:format24Hour="mm"
            android:letterSpacing="0.05" />

    </LinearLayout>

    <FrameLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:layout_width="64dip"
        android:layout_height="19dip"
        android:layout_marginTop="-5dp">

        <ImageView
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:src="@drawable/sparkls1_bg2"
            android:alpha="1.0" />

        <ImageView
            android:gravity="center"
            android:layout_gravity="center"
            android:paddingTop="2dip"
            android:paddingBottom="2dip"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:src="@drawable/sparkls1_bg1"
            android:alpha="0.5"
            android:paddingStart="2dip"
            android:paddingEnd="2dip" />

        <TextClock
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="@android:color/system_accent1_100"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@*android:string/config_clockFontFamily"
            android:singleLine="true"
            android:textAllCaps="false"
            android:format12Hour="EEE, MMM dd"
            android:format24Hour="EEE, MMM dd" />

    </FrameLayout>

</LinearLayout>
