<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clock_frame"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="end|top"
    android:gravity="end|top"
    android:orientation="vertical">

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="12.5dip" />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:gravity="end|top">

        <TextClock
            android:textSize="12dip"
            android:textColor="@android:color/system_accent1_100"
            android:id="@+id/lsclock9_d"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@*android:string/config_clockFontFamily"
            android:singleLine="true"
            android:format12Hour="MMMM dd "
            android:format24Hour="MMMM dd " />

        <LinearLayout
            android:layout_gravity="center"
            android:background="@drawable/anci_dot_bg"
            android:layout_width="2.5dip"
            android:layout_height="12.5dip" />

        <TextClock
            android:textSize="12dip"
            android:textColor="@android:color/system_accent1_100"
            android:id="@+id/lsclock9_e"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@*android:string/config_clockFontFamily"
            android:singleLine="true"
            android:format12Hour=" EEEE"
            android:format24Hour=" EEEE" />

    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:gravity="end|top">

        <TextClock
            android:textSize="50dip"
            android:textColor="@android:color/system_accent1_100"
            android:id="@+id/lsclock9_a"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@*android:string/config_clockFontFamily"
            android:singleLine="true"
            android:format12Hour="hh"
            android:format24Hour="HH" />

        <TextClock
            android:textSize="50dip"
            android:textColor="@android:color/system_accent1_100"
            android:id="@+id/lsclock9_b"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@*android:string/config_clockFontFamily"
            android:singleLine="true"
            android:format12Hour=":"
            android:format24Hour=":" />

        <TextClock
            android:textSize="50dip"
            android:textColor="@android:color/system_accent1_100"
            android:id="@+id/lsclock9_c"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@*android:string/config_clockFontFamily"
            android:singleLine="true"
            android:format12Hour="mm"
            android:format24Hour="mm" />
    </LinearLayout>

</LinearLayout>
