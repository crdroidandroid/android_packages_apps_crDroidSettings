<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clock_frame"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal|top"
    android:gravity="center_horizontal|top"
    android:orientation="vertical">

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="5dip" />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-10dip"
        android:gravity="center"
        android:layout_gravity="center">

        <TextClock
            android:textSize="45dip"
            android:textColor="@android:color/system_accent1_100"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/lsclock8_a"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@*android:string/config_clockFontFamily"
            android:singleLine="true"
            android:layout_alignParentStart="true"
            android:format12Hour="hh"
            android:format24Hour="HH" />

        <TextClock
            android:textSize="25dip"
            android:textColor="#00000000"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="-10dip"
            android:fontFamily="@*android:string/config_clockFontFamily"
            android:singleLine="true"
            android:layout_alignParentStart="true"
            android:format12Hour="    "
            android:format24Hour="    " />

    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-10dip"
        android:gravity="center"
        android:layout_gravity="center">

        <TextClock
            android:textSize="25dip"
            android:textColor="#00000000"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="-10dip"
            android:fontFamily="@*android:string/config_clockFontFamily"
            android:singleLine="true"
            android:layout_alignParentStart="true"
            android:format12Hour="    "
            android:format24Hour="    " />

        <TextClock
            android:textSize="45dip"
            android:textColor="@android:color/system_accent1_100"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/lsclock8_b"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@*android:string/config_clockFontFamily"
            android:singleLine="true"
            android:format12Hour="mm"
            android:format24Hour="mm" />

    </LinearLayout>

    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <TextClock
            android:textSize="10dip"
            android:textColor="@android:color/system_accent1_100"
            android:id="@+id/lsclock8_d"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@*android:string/config_clockFontFamily"
            android:singleLine="true"
            android:format12Hour="MMMM dd"
            android:format24Hour="MMMM dd" />

        <TextClock
            android:textSize="10dip"
            android:textColor="@android:color/system_accent1_100"
            android:id="@+id/lsclock8_e"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@*android:string/config_clockFontFamily"
            android:singleLine="true"
            android:format12Hour=", yyy"
            android:format24Hour=", yyy" />

    </LinearLayout>

    <TextClock
        android:textSize="10dip"
        android:textColor="@android:color/system_accent1_100"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/lsclock8_c"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@*android:string/config_clockFontFamily"
        android:singleLine="true"
        android:format12Hour="EEEE"
        android:format24Hour="EEEE" />
</LinearLayout>
