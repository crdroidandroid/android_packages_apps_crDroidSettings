<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clock_frame"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal|top"
    android:gravity="center_horizontal|top"
    android:orientation="vertical">

    <FrameLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <ImageView
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ls_bg_kotak2" />

        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextClock
                    android:textSize="20dip"
                    android:textStyle="bold"
                    android:textColor="@android:color/system_accent1_100"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@*android:string/config_clockFontFamily"
                    android:singleLine="true"
                    android:format12Hour="hh"
                    android:format24Hour="HH" />

                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="15dip"
                    android:layout_height="wrap_content" />

                <TextClock
                    android:textSize="20dip"
                    android:textColor="@android:color/system_accent1_100"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@*android:string/config_clockFontFamily"
                    android:singleLine="true"
                    android:format12Hour="mm"
                    android:format24Hour="mm" />

            </LinearLayout>

            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="5dip" />

            <TextClock
                android:paddingTop="3.75dip"
                android:textSize="10dip"
                android:textStyle="bold"
                android:textColor="@android:color/system_accent1_100"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@*android:string/config_clockFontFamily"
                android:singleLine="true"
                android:format12Hour="EEE dd"
                android:format24Hour="EEE dd" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
