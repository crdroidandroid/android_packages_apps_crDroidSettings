<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clock_frame"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal|top"
    android:gravity="center_horizontal|top"
    android:orientation="vertical">

    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="-10dip" />

    <FrameLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <com.airbnb.lottie.LottieAnimationView
            android:gravity="center"
            android:layout_gravity="center"
            android:clickable="false"
            android:layout_width="125dip"
            android:layout_height="125dip"
            android:layout_marginStart="0dip"
            app:lottie_autoPlay="true"
            app:lottie_rawRes="@raw/wallet"
            app:lottie_loop="true" />

        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="0dip">

            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="20dip" />

            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:paddingBottom="3dip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2.5dip">

                <TextClock
                    android:textSize="7dip"
                    android:textColor="@android:color/system_accent1_100"
                    android:id="@+id/lsclock9_d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@*android:string/config_clockFontFamily"
                    android:singleLine="true"
                    android:format12Hour=" MMMM dd "
                    android:format24Hour=" MMMM dd " />

                <LinearLayout
                    android:layout_gravity="center"
                    android:background="@drawable/anci_dot_bg"
                    android:layout_width="2.5dip"
                    android:layout_height="8dip" />

                <TextClock
                    android:textSize="7dip"
                    android:textColor="@android:color/system_accent1_100"
                    android:id="@+id/lsclock9_e"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@*android:string/config_clockFontFamily"
                    android:singleLine="true"
                    android:format12Hour=" EEEE"
                    android:format24Hour=" EEEE" />

            </LinearLayout>

            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="15dip" />

            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="0dip">

                    <TextClock
                        android:textSize="22.5dip"
                        android:textStyle="bold"
                        android:textColor="@android:color/system_accent1_100"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/lsclock9_a"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@*android:string/config_clockFontFamily"
                        android:singleLine="true"
                        android:format12Hour=" hh"
                        android:format24Hour=" HH" />

                    <TextClock
                        android:textSize="22.5dip"
                        android:textStyle="bold"
                        android:textColor="#00000000"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/lsclock9_c"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:format12Hour="   "
                        android:format24Hour="   " />

                </LinearLayout>

                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <TextClock
                        android:textSize="22.5dip"
                        android:textStyle="bold"
                        android:textColor="#00000000"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/lsclock9_c"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:format12Hour="   "
                        android:format24Hour="   " />

                    <TextClock
                        android:textSize="22.5dip"
                        android:textStyle="bold"
                        android:textColor="@android:color/system_accent1_100"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/lsclock9_c"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@*android:string/config_clockFontFamily"
                        android:singleLine="true"
                        android:format12Hour=" mm"
                        android:format24Hour=" mm" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="10dip" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
