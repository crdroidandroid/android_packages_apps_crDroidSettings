<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:overScrollMode="never"
    android:scrollIndicators="top|bottom"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <com.crdroid.settings.preferences.colorpicker.ColorPickerView
            android:id="@+id/color_picker_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_weight="1"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hex_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:labelFor="@+id/hex"
                android:textAppearance="?android:attr/textAppearanceListItemSecondary" />

            <EditText
                android:id="@+id/hex"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:imeOptions="actionDone"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:maxLines="1"
                android:singleLine="true"
                android:textAppearance="?android:attr/textAppearanceListItem" />

            <TextView
                android:id="@+id/hex_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/color_picker_hex_invalid"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="?android:attr/colorError"
                android:visibility="gone" />

            <TextView
                android:id="@+id/preset_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/color_picker_presets"
                android:textAppearance="?android:attr/textAppearanceListItemSecondary" />

            <HorizontalScrollView
                android:id="@+id/preset_scroller"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:overScrollMode="never"
                android:requiresFadingEdge="horizontal"
                android:fadingEdgeLength="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/preset_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="true"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.crdroid.settings.preferences.colorpicker.ColorPickerPanelView
                    android:id="@+id/old_color_panel"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="@string/color_picker_current_color" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:text="@string/color_picker_arrow_right"
                    android:textSize="20sp" />

                <com.crdroid.settings.preferences.colorpicker.ColorPickerPanelView
                    android:id="@+id/new_color_panel"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="@string/color_picker_new_color" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
